PORT=8787
HOST=0.0.0.0

# URL fixa da instância Pleroma. O frontend envia o Bearer token do usuário
# e o backend o valida em /api/v1/accounts/verify_credentials.
PLEROMA_INSTANCE_URL=https://social.luizpicolo.com.br

# Endpoint RPC do Kubo/IPFS. Nunca exponha essa URL diretamente ao navegador.
IPFS_API_URL=http://192.168.0.28:5001

# Gateway público usado para montar links ipfs:// ou HTTP.
IPFS_GATEWAY_URL=https://ipfs.io

# URL pública desta API, usada nos metadados retornados.
PUBLIC_BASE_URL=http://localhost:8787

# Em produção, troque * pelo domínio do frontend.
CORS_ORIGIN=http://localhost:5173

MAX_FILE_SIZE=52428800
STORAGE_DIR=./data/uploads
USER_KEYS_DIR=./src/keys/users

# Cache local dos objetos IPFS usados na verificação automática.
IPFS_CACHE_DIR=./data/cache/ipfs
